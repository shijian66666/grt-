#include <stdio.h>
int main()
{
    int a,b;
    int count =0;
    int num,i;
    scanf("%d%d",&a,&b);
    for(i=a;i<=b;i++)
    {
        num=i;
        while(num>=10)
        {
           if(num%10 == 2)
           {
            count++;
           }
        num=num/10;
        }
        if(num%10 == 2)
        {
            count++;
        }
    }
        printf("%d",count);
        return 0;
}
